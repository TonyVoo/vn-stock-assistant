# Sao chép thành .env rồi điền key. KHÔNG commit file .env.
ANTHROPIC_API_KEY=
# Model dùng cho bản tin / phân tích (đổi nếu muốn rẻ hơn, ví dụ claude-haiku-5-5)
CLAUDE_MODEL=claude-sonnet-5-5
# Đặt DEMO_MODE=1 để dùng dữ liệu giả lập (khi chưa có mạng/nguồn dữ liệu)
DEMO_MODE=0

# --- Chọn nhà cung cấp AI ---
# anthropic     : dùng Claude API (tính phí theo token, cần ANTHROPIC_API_KEY)
# mock          : trả kết quả mẫu, miễn phí, chỉ để thử giao diện
# openai_compat : dịch vụ tương thích OpenAI (Ollama trên máy, Gemini...)
LLM_PROVIDER=anthropic
# Ví dụ Ollama (miễn phí, chạy trên máy):  base=http://localhost:11434/v1  model=qwen2.5:7b
# Ví dụ Gemini (có gói miễn phí): base=https://generativelanguage.googleapis.com/v1beta/openai  model=gemini-3.5-flash-lite
OPENAI_COMPAT_BASE_URL=
OPENAI_COMPAT_API_KEY=
OPENAI_COMPAT_MODEL=

# --- Kết nối TCBS (CHỈ ĐỌC danh mục, tuỳ chọn) ---
# Lấy khoá trong app TCInvest: Menu trái, Tiện ích, iFlash Open API. Khoá TCBS không có chế độ chỉ-đọc, nên đừng chia sẻ khoá này.
# Mỗi lần lấy dữ liệu bạn nhập Smart OTP ngay trong app (không lưu vào file).
TCBS_API_KEY=
TCBS_ACCOUNT_NO=
TCBS_CUSTODY_CODE=
